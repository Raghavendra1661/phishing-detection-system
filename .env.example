# Copy to .env and fill in. Never commit .env.
APP_ENV=development
# Comma-separated list of allowed frontend origins (production: your real site)
CORS_ORIGINS=http://localhost:5173
DATABASE_PATH=data/phishguard.db
# Optional threat-intelligence keys (leave blank to disable that provider)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
RATE_LIMIT_ANALYZE_PER_MIN=20
RATE_LIMIT_DEFAULT_PER_MIN=60
